# Copy to .env (gitignored). Variable names only; never commit real values.

# --- Catalog (pnpm catalog:dev) ---
# Leave MONGODB_URI unset to use the local mongod started by `pnpm catalog:dev`
# (cached mongodb-memory-server binary, persistent data in .data/mongo).
# Set it to your MongoDB Atlas connection string to switch to Atlas automatically; no code changes.
MONGODB_URI=
MONGODB_DB=token_optimizer
# Port for the local mongod (only used when MONGODB_URI is unset)
MONGO_DEV_PORT=27027
# Named human recorded as reviewedBy when catalog:dev approves the seeded techniques
CATALOG_REVIEWER=

# --- Catalog API ---
PORT=3000
HOST=127.0.0.1

# --- Live smoke test (pnpm smoke:live); each provider runs only when its key is set ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
