  "strategies": [
    {
      "id": "whitespace-normalize",
      "name": "Whitespace Normalization",
      "group": "prompt-efficiency",
      "targets": [
        "runtime"
      ],
      "summary": "Collapse runs of spaces and blank lines, strip trailing whitespace and markdown rule lines.",
      "savings": {
        "minPercent": 1,
        "maxPercent": 8,
        "basis": "Whitespace and decorative markdown tokens removed from typical prompts",
        "unit": "percent",
        "appliesTo": "input"
      },
      "optimizer": {
        "mode": "rule",
        "ruleId": "whitespace-normalize",
        "order": 10,
        "affects": "input"
      },
      "implementation": {
        "language": "python",
        "symbol": "optimize_messages",
        "integrations": [
          "agent-middleware",
          "invoke-wrap"
        ]
      },
      "reviewStatus": "approved",
