      "version": 1
    },
    {
      "id": "filler-removal",
      "name": "Prompt Compressor (filler removal)",
      "group": "prompt-efficiency",
      "targets": [
        "runtime"
      ],
      "summary": "Drop politeness, hedging and redundant phrases from a curated list.",
      "applicability": {
        "path": "llm.avgPromptTokens",
        "gte": 500
      },
      "reasonTemplate": "Prompts average {{value}} tokens; filler phrases are cheap to remove.",
      "savings": {
        "minPercent": 3,
        "maxPercent": 12,
        "basis": "Curated filler phrase list applied to conversational prompts",
        "unit": "percent",
        "appliesTo": "input"
      },
      "optimizer": {
        "mode": "rule",
        "ruleId": "filler-removal",
        "order": 20,
        "affects": "input",
        "params": {
          "phrases": [
            "please note that",
            "it is important to note that",
            "i would like you to",
            "could you please",
            "can you please",
            "please",
            "kindly",
            "basically",
            "actually",
            "just",
            "really",
            "very",
            "in order to",
            "as an ai language model,",
            "thank you in advance",
            "thanks in advance"
          ]
        }
      },
      "implementation": {
        "language": "python",
        "symbol": "optimize_messages",
